# 默认按文本处理，交给 git 自动判定
* text=auto

# 源码与文档统一 LF，避免跨平台换行符噪音
*.py       text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.vue      text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.html     text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.ini      text eol=lf
*.sql      text eol=lf
*.sh       text eol=lf

# Windows 批处理保留 CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf

# 二进制
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.safetensors binary
*.bin       binary
*.pyc       binary
