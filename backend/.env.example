# 复制本文件到 backend 目录、去掉 .example 后缀，然后填入真实值
# 生成随机密钥: python -c "import secrets;print(secrets.token_urlsafe(64))"

# 数据库（建议用专用最小权限账号，不要 root）
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/lab_agent

# JWT（必填，无默认值；缺失会导致应用启动失败）
JWT_SECRET_KEY=CHANGE_ME_64_BYTES_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 大模型（留空则 AI 功能自动降级不可用，不影响其余接口）
LLM_API_KEY=
LLM_BASE_URL=https://api.agnes-ai.cn/v1
LLM_MODEL=agnes-2.5-flash